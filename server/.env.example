# Apenas para a API local; nunca inclua esta URL no Flutter.
# O usuário PostgreSQL precisa de CREATEDB na primeira inicialização.
DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5432/limitbreaker

# Opcional: promove uma conta existente a administrador quando a API inicia.
ADMIN_USERNAME=

# Os campos abaixo só são exigidos quando ADMIN_USERNAME ainda não existe.
# Nunca versione uma senha real neste arquivo.
ADMIN_DISPLAY_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_AGE=
ADMIN_HEIGHT_CM=
ADMIN_WEIGHT_KG=

# Use true somente para trocar intencionalmente a senha de uma conta existente.
ADMIN_RESET_PASSWORD=false
